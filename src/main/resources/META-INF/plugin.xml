<idea-plugin>
    <!-- Уникальный ID плагина -->
    <id>com.arkannsk.elval</id>

    <!-- Название, которое видит пользователь -->
    <name>ElVal Helper</name>

    <!-- Версия плагина (должна совпадать с version в build.gradle.kts) -->
    <version>1.0.0</version>

    <!-- Автор или компания -->
    <vendor url="https://github.com/arkannsk">arkannsk</vendor>

    <!-- Описание плагина -->
    <description><![CDATA[
        Syntax highlighting and completion for ElVal annotations in Go files.
        Supports @evl:validate, @evl:decor, @oa:tags and more.
    ]]></description>

    <!-- Зависимости -->
    <!-- Базовая платформа IntelliJ -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Подсветка синтаксиса -->
        <annotator language="go" implementationClass="com.arkannsk.elval.ElvalAnnotator"/>

        <!-- Настройки цветов -->
        <colorSettingsPage implementation="com.arkannsk.elval.ElvalColorSettingsPage"/>

        <!-- Автодополнение -->
        <completion.contributor language="go" implementationClass="com.arkannsk.elval.completion.ElvalCompletionContributor"/>
    </extensions>
</idea-plugin>
